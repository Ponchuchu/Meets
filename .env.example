# Публичные значения по умолчанию берутся из config/public-keys.json — переопределять не обязательно.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_MAPBOX_TOKEN=
# demo — работать только на демо-данных; auto — Supabase, при ошибке демо (по умолчанию).
EXPO_PUBLIC_DATA_MODE=auto

# Только для скриптов (npm run db:migrate / seed:events), в приложение не попадает. НЕ коммитить.
# В облачной среде Claude Code вместо него — API credential для api.supabase.com (см. docs/KEYS.md).
SUPABASE_ACCESS_TOKEN=

# Секреты Edge Functions — не здесь, а в Supabase → Edge Functions → Secrets (см. docs/KEYS.md, «Этап 8»):
# CRON_SECRET=        общий пароль для вызовов из pg_cron (тот же — в Vault как cron_secret)
# EXPO_ACCESS_TOKEN=  если включена защита пушей в Expo
