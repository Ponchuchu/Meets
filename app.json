{
  "expo": {
    "name": "рядом.",
    "slug": "ryadom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ryadom",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.ryadom.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Показываем события рядом с тобой и твою точку друзьям — только если ты сам включил «делиться».",
        "NSPhotoLibraryUsageDescription": "Чтобы отправить фото в чат или загрузить афишу в «Предложить событие».",
        "NSCameraUsageDescription": "Чтобы снять фото или кружок для чата.",
        "NSMicrophoneUsageDescription": "Чтобы записать голосовое или кружок для чата.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3F0E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "kz.ryadom.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3F0E8"
        }
      ],
      "expo-font",
      "@rnmapbox/maps",
      [
        "expo-notifications",
        {
          "color": "#F0521F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Показываем события рядом с тобой и твою точку друзьям — только если ты сам включил «делиться».",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Чтобы отправить фото в чат или загрузить афишу в «Предложить событие».",
          "cameraPermission": "Чтобы снять фото или кружок для чата."
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4750246-b45d-49cd-ae10-ccb674456f7f"
      }
    },
    "owner": "rilyton"
  }
}
